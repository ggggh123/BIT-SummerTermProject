    <file alias="person.svg">ui/person.svg</file>
    <file alias="back.svg">ui/back.svg</file>
    <file alias="charger.svg">ui/charger.svg</file>
    <file alias="expand-more.svg">ui/expand-more.svg</file>
  </qresource>
