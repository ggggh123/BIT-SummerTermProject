    },
    {
      "id": "Q7",
      "name": "孤儿引用",
      "policy": "维度清洗后再校验外键，记录级联影响"
    },
    {
      "id": "Q8",
      "name": "非法字段值",
      "policy": "手机号、状态、类型枚举等"
    },
    {
      "id": "Q9",
      "name": "经纬度越界",
      "policy": "北京包围框仅作项目规则，不等同真实行政边界"
    },
    {
      "id": "Q10",
      "name": "文本脏数据",
      "policy": "空白、全半角标准化；不可恢复乱码单独处置"
    }
  ]
