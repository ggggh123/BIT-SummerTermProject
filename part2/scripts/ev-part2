#!/usr/bin/env bash
# 第二阶段运行时命令包装器。
# 默认从 ${EV_PART2_TOOLCHAIN:-/usr/local/ev-part2} 加载环境，因此可用 EV_PART2_TOOLCHAIN 迁移整套运行时。
set -euo pipefail
ev_p2_toolchain="${EV_PART2_TOOLCHAIN:-/usr/local/ev-part2}"
source "$ev_p2_toolchain/env.sh"
case "${1:-help}" in
  configure)
    exec "$EV_PART2_PYTHON" "$ev_p2_toolchain/bin/configure_local.py" ;;
  start|stop|status)
    exec bash "$ev_p2_toolchain/bin/cluster.sh" "$1" ;;
  python)
    shift
    exec "$EV_PART2_PYTHON" "$@" ;;
  help)
    echo '用法：ev-part2 configure|start|stop|status|python|hdfs|hadoop|yarn|spark-submit|pyspark [参数]'
    echo "当前工具链：$ev_p2_toolchain"
    echo "Python：$EV_PART2_PYTHON（可用 EV_PART2_PYTHON 覆盖）" ;;
  hdfs|hadoop|yarn|spark-submit|pyspark|java|javac|jps)
    exec "$@" ;;
  *)
    echo "未知命令：$1" >&2
    exit 2 ;;
esac
